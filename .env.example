# ------------------------------------------------------------------
# Chayar Asroy — Environment Variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real secrets.
#
# Variables are validated at build/runtime in `src/config/env.ts`.
# ------------------------------------------------------------------

# Public canonical site URL. Used for metadata, canonical links,
# sitemap.xml and robots.txt. Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (wired up in Phase 3) -------------------------------
# The project URL and anon key are PUBLIC by design (protected by
# Row Level Security). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER-ONLY. Bypasses Row Level Security — treat like a root password.
# Never prefix with NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Build escape hatch -------------------------------------------
# Set to 1 to skip environment validation (e.g. Docker image builds
# where env is injected at runtime rather than build time).
# SKIP_ENV_VALIDATION=1
